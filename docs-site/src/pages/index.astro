---
/**
 * FolioOrb public home — v5.16.1 review ledger.
 *
 * One bounded story: holdings → local read → attention → portable record.
 * Real product captures prove the claims; release metadata progressively
 * enhances static, always-usable links.
 */
import '../styles/landing.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const REPO = 'udhawan97/FolioOrb';
const GITHUB = `https://github.com/${REPO}`;
const RELEASES = `${GITHUB}/releases`;
const RELEASES_LATEST = `${RELEASES}/latest`;
const LATEST_MAIN = `${RELEASES}/tag/latest-main`;
const RAW = 'https://raw.githubusercontent.com';
const APP_VERSION = 'v5.16.1';

const asset = (path) => `${base}/assets/${path}`;
const shot = (path) => `${base}/assets/shots/${path}`;
const doc = (slug) => `${base}/${slug}/`;

const macCommand = `curl -fsSL ${RAW}/${REPO}/main/scripts/install-mac.sh | bash`;
const windowsCommand = `irm ${RAW}/${REPO}/main/scripts/install-win.ps1 | iex`;

const loop = [
  {
    label: 'Holdings',
    title: 'Bring the facts together',
    body: 'Add positions, a strict CSV, or research-only tickers. No brokerage link and no FolioOrb account.',
  },
  {
    label: 'Local read',
    title: 'See what changed and why',
    body: 'Known USD value, exposure, risk, filings, dividends, and news stay tied to their source quality.',
  },
  {
    label: 'Attention',
    title: 'Review the work, not the noise',
    body: 'Review Orbit separates data gaps, thesis work, reminders, comparison, and planning.',
  },
  {
    label: 'Record',
    title: 'Keep an evidence trail',
    body: 'Save receipts, snapshots, readable records, verified backups, or one checksummed review bundle.',
  },
];

const proof = [
  {
    eyebrow: 'Review Inbox',
    title: 'Attention has a queue—and missing data keeps its name.',
    body: 'Filter All, Data gaps, Needs review, and On the radar without changing the underlying queue or hiding its total.',
    image: 'review-inbox-demo.webp',
    width: 1600,
    height: 1171,
    alt: 'Review Orbit Inbox with fictional demo holdings, thesis work, verdict calibration, and an upcoming event.',
    link: doc('dashboard/review-orbit'),
  },
  {
    eyebrow: 'Plan & Protect',
    title: 'Choose a course without pretending it is a trade.',
    body: 'Set exact basis-point targets, see quote exclusions, rehearse one external-cash USD buy, and export a descriptive snapshot.',
    image: 'plan-protect-demo.webp',
    width: 1600,
    height: 1171,
    alt: 'Review Orbit Plan and Protect with fictional target allocations and a read-only buy rehearsal.',
    link: doc('dashboard/review-orbit'),
  },
  {
    eyebrow: 'Analytics & risk',
    title: 'Numbers stay legible after the headline.',
    body: 'Concentration, drawdown, volatility, beta, correlation, and exposure explain what they cover—and what they cannot.',
    image: 'risk-analytics-demo.webp',
    width: 1600,
    height: 1829,
    alt: 'FolioOrb risk analytics with a risk-return view, correlation matrix, and concentration detail.',
    link: doc('dashboard/analytics-risk'),
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FolioOrb — A local portfolio review you can keep</title>
    <meta name="description" content="FolioOrb turns holdings, risk, news, and public market context into a local review loop with explicit data quality and portable records. Claude is optional; no brokerage connection or telemetry." />
    <link rel="canonical" href="https://udhawan97.github.io/FolioOrb/" />
    <link rel="icon" type="image/svg+xml" href={asset('folio-orbit-icon.svg')} />
    <meta name="theme-color" content="#050508" />
    <meta property="og:title" content="FolioOrb — A local portfolio review you can keep" />
    <meta property="og:description" content="See what changed, decide what deserves attention, and keep the record—on your machine." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://udhawan97.github.io/FolioOrb/" />
    <meta property="og:image" content="https://udhawan97.github.io/FolioOrb/assets/og-hero.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://udhawan97.github.io/FolioOrb/assets/og-hero.jpg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="orbit-field" aria-hidden="true"><span></span><span></span><span></span></div>

    <header class="site-header">
      <a class="wordmark" href={base + '/'} aria-label="FolioOrb home">
        <img src={asset('folio-orbit-icon.svg')} alt="" width="30" height="30" />
        <span>FolioOrb</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#review-loop">How it works</a>
        <a class="nav-optional" href={doc('get-started/introduction')}>Docs</a>
        <a class="nav-optional" href={GITHUB}>GitHub</a>
        <a class="nav-download" href="#download">Download</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero section-shell" aria-labelledby="hero-title">
        <div class="hero-copy reveal">
          <p class="status-line"><span></span>Local-first portfolio review</p>
          <h1 id="hero-title">See what changed.<br /><em>Keep the reasoning.</em></h1>
          <p class="hero-lede">
            FolioOrb turns holdings, risk, news, and public market context into an explainable
            review loop—then keeps its queue, receipts, and backups on your machine. Claude is
            optional. There is no telemetry, brokerage connection, or automatic trade.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#download">Choose how to run it</a>
            <a class="button secondary" href={doc('get-started/introduction')}>Read the guide</a>
          </div>
          <ul class="trust-row" aria-label="Product boundaries">
            <li>Local SQLite</li>
            <li>No account</li>
            <li>Claude optional</li>
            <li>SHA-256 checksums</li>
          </ul>
          <div class="release-line" id="release-line">
            <span class="release-source">Source {APP_VERSION}</span>
            <span aria-hidden="true">·</span>
            <a data-role="release-link" href={RELEASES_LATEST}>Latest stable release</a>
            <span data-role="release-meta" hidden></span>
          </div>
        </div>

        <figure class="hero-proof reveal">
          <div class="hero-frame">
            <img src={shot('hero-cockpit-v3.webp')} width="2400" height="1508" fetchpriority="high"
              alt="FolioOrb overview for a fictional demo portfolio, showing known USD value, today's impact, sector exposure, and a local briefing." />
            <span class="proof-pin pin-value">Known value</span>
            <span class="proof-pin pin-source">Local read</span>
          </div>
          <figcaption>Real FolioOrb UI · fictional holdings · provider data may be partial</figcaption>
        </figure>
      </section>

      <section class="section-shell loop-section" id="review-loop" aria-labelledby="loop-title">
        <div class="section-intro reveal">
          <p class="section-label">The review loop</p>
          <h2 id="loop-title">Four checkpoints. One record you control.</h2>
          <p>The interface follows the same path each time, so a read can become a decision trail instead of another dashboard glance.</p>
        </div>
        <ol class="review-loop reveal">
          {loop.map((step, index) => (
            <li>
              <span class="loop-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="loop-node" aria-hidden="true"></span>
              <p class="loop-label">{step.label}</p>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="proof-section section-shell" aria-labelledby="proof-title">
        <div class="section-intro reveal">
          <p class="section-label">Product proof</p>
          <h2 id="proof-title">The useful answer is one you can inspect.</h2>
          <p>Each major claim below is anchored to a current app surface captured from an isolated fictional profile.</p>
        </div>
        <div class="proof-list">
          {proof.map((item, index) => (
            <article class:list={['proof-card', 'reveal', { reverse: index % 2 === 1 }]}>
              <div class="proof-copy">
                <p class="section-label">{item.eyebrow}</p>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
                <a href={item.link}>See this workflow in the docs <span aria-hidden="true">→</span></a>
              </div>
              <figure>
                <img src={shot(item.image)} width={item.width} height={item.height} loading="lazy" alt={item.alt} />
              </figure>
            </article>
          ))}
        </div>
      </section>

      <section class="boundary-section" aria-labelledby="boundary-title">
        <div class="section-shell">
          <div class="section-intro reveal">
            <p class="section-label">The trust boundary</p>
            <h2 id="boundary-title">Local-first, with the network named out loud.</h2>
            <p>FolioOrb is not offline-only. It makes specific outbound requests for specific jobs, while portfolio state remains local.</p>
          </div>
          <div class="boundary-grid reveal">
            <article>
              <span class="boundary-mark local" aria-hidden="true"></span>
              <h3>Stays on this device</h3>
              <p>Holdings, costs, notes, thesis text, snapshots, settings, backups, receipts, and cached generated summaries.</p>
            </article>
            <article>
              <span class="boundary-mark outbound" aria-hidden="true"></span>
              <h3>Leaves for a named job</h3>
              <p>Public quotes, history, headlines, and indices are fetched on demand. Bounded lookups go to Yahoo Finance, SEC EDGAR, Treasury, GitHub, news image hosts, and—when configured—Anthropic.</p>
            </article>
            <article>
              <span class="boundary-mark never" aria-hidden="true"></span>
              <h3>Never becomes a trade</h3>
              <p>No brokerage connection, order placement, cloud portfolio upload, telemetry, silent FX conversion, or invented zero.</p>
            </article>
          </div>
          <p class="boundary-detail reveal"><a href={doc('privacy')}>Read the exact provider and Claude payload boundaries →</a></p>
        </div>
      </section>

      <section class="current-section section-shell" aria-labelledby="current-title">
        <div class="current-card reveal">
          <div>
            <p class="section-label">Current source · {APP_VERSION}</p>
            <h2 id="current-title">The public surface now matches the hardened review workflow.</h2>
          </div>
          <div class="current-copy">
            <p>This patch refreshes documentation and moves one-line source installs onto a durable profile outside the replaceable code tree. Core portfolio behavior remains the v5.16 hardening release:</p>
            <ul>
              <li>one checksummed review bundle;</li>
              <li>responsive CSV provider work and fresh reconciliation;</li>
              <li>one fail-closed runtime profile;</li>
              <li>explicit duplicate-row recovery with verified backup and no recorded sale.</li>
            </ul>
            <a href={doc('release-notes')}>Read the release notes <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section class="download-section" id="download" aria-labelledby="download-title">
        <div class="section-shell">
          <div class="section-intro reveal">
            <p class="section-label">Run it your way</p>
            <h2 id="download-title">Choose the path that fits this machine.</h2>
            <p>Every path runs FolioOrb locally. Desktop installers need no Python; the source path supports macOS, Windows, and Linux.</p>
          </div>
          <div class="download-grid reveal">
            <article class="download-card" data-platform="mac">
              <div class="platform-line"><span class="platform-icon mac" aria-hidden="true"></span><span data-role="recommendation" hidden>Recommended here</span></div>
              <h3>macOS desktop</h3>
              <p class="platform-meta">Apple Silicon · macOS 11+ · DMG</p>
              <p>No Python or terminal. The build is ad-hoc signed but not Developer ID signed or notarized, so Gatekeeper warns on first launch.</p>
              <a id="download-mac" class="download-action" href={RELEASES_LATEST}>Open the latest `.dmg`</a>
              <a class="text-link" href={doc('install-macos')}>macOS install guide →</a>
            </article>
            <article class="download-card" data-platform="win">
              <div class="platform-line"><span class="platform-icon win" aria-hidden="true"></span><span data-role="recommendation" hidden>Recommended here</span></div>
              <h3>Windows desktop</h3>
              <p class="platform-meta">x64 · Windows 10/11 · EXE</p>
              <p>Per-user installer with no administrator requirement. It is not Authenticode signed, so SmartScreen may warn on first launch.</p>
              <a id="download-win" class="download-action" href={RELEASES_LATEST}>Open the latest `.exe`</a>
              <a class="text-link" href={doc('install-windows')}>Windows install guide →</a>
            </article>
            <article class="download-card" data-platform="source">
              <div class="platform-line"><span class="platform-icon source" aria-hidden="true"></span></div>
              <h3>Local browser app</h3>
              <p class="platform-meta">macOS · Windows · Linux · Python 3.11+</p>
              <p>Clone the source, run one setup script, and open the same dashboard at <code>localhost:8000</code>.</p>
              <a class="download-action" href={doc('build-from-source')}>Build from source</a>
              <a class="text-link" href={GITHUB}>Inspect the repository →</a>
              <a class="text-link" href={LATEST_MAIN}>Test the latest-main development build →</a>
            </article>
          </div>

          <div class="install-ledger reveal">
            <div>
              <p class="section-label">One-line source setup</p>
              <div class="command-row" data-copy={macCommand}>
                <code>{macCommand}</code>
                <button class="copy-button" type="button">Copy</button>
              </div>
              <div class="command-row" data-copy={windowsCommand}>
                <code>{windowsCommand}</code>
                <button class="copy-button" type="button">Copy</button>
              </div>
            </div>
            <div class="checksum-block">
              <p class="section-label">Verify before opening</p>
              <p>Current v5 releases include `SHA256SUMS.txt`. It detects mismatch against that same release's manifest; Minisign authenticity is not configured.</p>
              <div class="command-row" data-copy="grep 'FolioOrb-macOS-arm64-v5.16.1.dmg$' SHA256SUMS.txt | shasum -a 256 -c -">
                <code>grep 'FolioOrb-macOS-arm64-v5.16.1.dmg$' SHA256SUMS.txt | shasum -a 256 -c -</code>
                <button class="copy-button" type="button">Copy</button>
              </div>
              <a class="text-link" href={doc('download')}>Download and checksum details →</a>
            </div>
          </div>
        </div>
      </section>

      <section class="continuation section-shell" aria-labelledby="continuation-title">
        <div class="continuation-copy reveal">
          <p class="section-label">Keep going</p>
          <h2 id="continuation-title">Start with the app. Keep the evidence close.</h2>
          <p>Use the guide for first launch, the release page for exact artifacts, and the issue tracker when a documented path does not match what you see.</p>
        </div>
        <div class="continuation-links reveal">
          <a href={doc('get-started/introduction')}><span>First review</span><strong>Get started →</strong></a>
          <a href={RELEASES}><span>Builds and checksums</span><strong>All releases →</strong></a>
          <a href={`${GITHUB}/issues/new`}><span>Something failed</span><strong>Open an issue →</strong></a>
        </div>
      </section>
    </main>

    <footer>
      <div class="section-shell footer-inner">
        <div class="footer-brand">
          <img src={asset('folio-orbit-icon.svg')} alt="" width="28" height="28" />
          <span><strong>FolioOrb</strong><small>A local portfolio review you can keep.</small></span>
        </div>
        <nav aria-label="Footer navigation">
          <a href={doc('get-started/introduction')}>Docs</a>
          <a href={RELEASES}>Releases</a>
          <a href={GITHUB}>GitHub</a>
          <a href={`${GITHUB}/blob/main/LICENSE`}>Apache 2.0</a>
        </nav>
      </div>
    </footer>

    <script define:vars={{ API: `https://api.github.com/repos/${REPO}/releases/latest` }}>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const platform = (() => {
        const value = (navigator.userAgentData?.platform || navigator.platform || navigator.userAgent || '').toLowerCase();
        return value.includes('mac') ? 'mac' : value.includes('win') ? 'win' : 'source';
      })();
      const preferred = document.querySelector(`[data-platform="${platform}"]`);
      preferred?.classList.add('preferred');
      const recommendation = preferred?.querySelector('[data-role="recommendation"]');
      if (recommendation) recommendation.hidden = false;

      const formatSize = (size) => size ? `${Math.round(size / 1048576)} MB` : '';
      const formatDate = (date) => {
        try { return new Date(date).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }); }
        catch { return ''; }
      };
      const findAsset = (assets, suffix) => assets.find((item) => item.name.toLowerCase().endsWith(suffix));
      const setDownload = (id, item, release) => {
        const link = document.getElementById(id);
        if (!link || !item) return;
        link.href = item.browser_download_url;
        link.textContent = `Download ${release.tag_name} · ${formatSize(item.size)}`;
      };

      fetch(API, { headers: { Accept: 'application/vnd.github+json' } })
        .then((response) => response.ok ? response.json() : null)
        .then((release) => {
          if (!release?.assets) return;
          setDownload('download-mac', findAsset(release.assets, '.dmg'), release);
          setDownload('download-win', findAsset(release.assets, '.exe'), release);
          const link = document.querySelector('[data-role="release-link"]');
          if (link && release.html_url) {
            link.href = release.html_url;
            link.textContent = release.tag_name || 'Latest stable release';
          }
          const meta = document.querySelector('[data-role="release-meta"]');
          if (meta) {
            meta.textContent = `· ${formatDate(release.published_at)}`;
            meta.hidden = !release.published_at;
          }
        })
        .catch(() => { /* static release links remain useful offline */ });

      document.querySelectorAll('.copy-button').forEach((button) => {
        button.addEventListener('click', async () => {
          const row = button.closest('[data-copy]');
          const value = row?.getAttribute('data-copy') || '';
          try {
            await navigator.clipboard.writeText(value);
            const previous = button.textContent;
            button.textContent = 'Copied';
            setTimeout(() => { button.textContent = previous; }, 1300);
          } catch { button.textContent = 'Select text'; }
        });
      });

      const reveal = document.querySelectorAll('.reveal');
      if (reduceMotion || !('IntersectionObserver' in window)) {
        reveal.forEach((item) => item.classList.add('visible'));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -5% 0px' });
        reveal.forEach((item) => observer.observe(item));
      }
    </script>
  </body>
</html>
